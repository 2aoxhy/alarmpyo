{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alarmpyo.example/release-ledger.schema.json",
  "title": "AlarmPyo release ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageName", "apkReleases", "otaPromotions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageName": { "const": "com.personal.alarmpyo" },
    "apkReleases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "versionName",
          "versionCode",
          "sha256",
          "sizeBytes",
          "primaryUrl",
          "mirrors",
          "sourceCommit",
          "easBuildId",
          "nativeFingerprint",
          "deviceMatrix",
          "evidenceLevel",
          "promotedAt"
        ],
        "properties": {
          "versionName": { "type": "string", "minLength": 1 },
          "versionCode": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "sizeBytes": { "type": "integer", "minimum": 1 },
          "primaryUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "mirrors": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
          "easBuildId": { "type": "string", "format": "uuid" },
          "nativeFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "deviceMatrix": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "apkSha256",
              "sourceCommit",
              "easBuildId",
              "nativeFingerprint",
              "bindingSha256",
              "checkedAt",
              "physicalEvidenceSha256",
              "emulatorEvidence"
            ],
            "properties": {
              "schemaVersion": { "const": 3 },
              "apkSha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "sourceCommit": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{40}$"
              },
              "easBuildId": { "type": "string", "format": "uuid" },
              "nativeFingerprint": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "bindingSha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "checkedAt": { "type": "string", "format": "date-time" },
              "physicalEvidenceSha256": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{64}$"
              },
              "emulatorEvidence": {
                "type": "array",
                "minItems": 5,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["sdk", "sha256"],
                  "properties": {
                    "sdk": { "enum": [31, 33, 34, 35, 36] },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{64}$"
                    }
                  }
                }
              }
            }
          },
          "evidenceLevel": { "const": "verified-v3" },
          "promotedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "otaPromotions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel",
          "previousBranch",
          "candidateBranch",
          "versionName",
          "versionCode",
          "sourceCommit",
          "baseApkSha256",
          "groups",
          "promotedAt"
        ],
        "properties": {
          "channel": { "enum": ["stable", "canary"] },
          "previousBranch": { "type": "string", "minLength": 1 },
          "candidateBranch": {
            "type": "string",
            "pattern": "^release-candidate-(stable|canary)-"
          },
          "versionName": { "type": "string", "minLength": 1 },
          "versionCode": { "type": "integer", "minimum": 1 },
          "sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
          "baseApkSha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$"
          },
          "groups": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "promotedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
