{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alarmpyo.example/android-device-evidence.schema.json",
  "title": "AlarmPyo Android device evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "captureMethod",
    "deviceType",
    "sdk",
    "checkedAt",
    "properties",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "captureMethod": { "const": "adb" },
    "deviceType": { "enum": ["physical", "emulator"] },
    "sdk": { "enum": [31, 33, 34, 35, 36] },
    "checkedAt": { "type": "string", "format": "date-time" },
    "properties": {
      "type": "object",
      "required": ["buildFingerprint"],
      "properties": {
        "manufacturer": { "type": "string" },
        "model": { "type": "string" },
        "avdName": { "type": "string" },
        "release": { "type": "string" },
        "buildFingerprint": { "type": "string", "minLength": 2 }
      }
    },
    "checks": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": { "type": "boolean" }
    }
  }
}
