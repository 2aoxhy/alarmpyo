{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alarmpyo.example/android-device-matrix.schema.json",
  "title": "AlarmPyo Android release device matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageName",
    "versionName",
    "versionCode",
    "apkSha256",
    "sourceCommit",
    "easBuildId",
    "nativeFingerprint",
    "checkedAt",
    "physicalDevice",
    "emulators"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "packageName": { "const": "com.personal.alarmpyo" },
    "versionName": { "type": "string" },
    "versionCode": { "type": "integer", "minimum": 1 },
    "apkSha256": { "$ref": "#/$defs/sha256" },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "easBuildId": { "type": "string", "format": "uuid" },
    "nativeFingerprint": { "$ref": "#/$defs/sha256" },
    "checkedAt": { "type": "string", "format": "date-time" },
    "physicalDevice": { "$ref": "#/$defs/physicalDevice" },
    "emulators": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/emulator" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.release/device-evidence/[A-Za-z0-9._-]+\\.json$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "baseDevice": {
      "type": "object",
      "required": [
        "sdk",
        "osVersion",
        "buildFingerprint",
        "checkedAt",
        "evidence",
        "alarmWhileClosed",
        "alarmAfterReboot",
        "blockedNotificationState",
        "fullScreenAlarm",
        "widgetAvailable"
      ],
      "properties": {
        "sdk": { "type": "integer", "minimum": 31, "maximum": 36 },
        "osVersion": { "type": "string", "minLength": 2 },
        "buildFingerprint": { "type": "string", "minLength": 2 },
        "checkedAt": { "type": "string", "format": "date-time" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "alarmWhileClosed": { "const": true },
        "alarmAfterReboot": { "const": true },
        "blockedNotificationState": { "const": true },
        "fullScreenAlarm": { "const": true },
        "widgetAvailable": { "const": true }
      }
    },
    "physicalDevice": {
      "allOf": [
        { "$ref": "#/$defs/baseDevice" },
        {
          "type": "object",
          "required": [
            "deviceType",
            "currentSamsungDevice",
            "manufacturer",
            "model",
            "upgradePreservedData",
            "permissionsPreserved"
          ],
          "properties": {
            "deviceType": { "const": "physical" },
            "currentSamsungDevice": { "const": true },
            "manufacturer": { "type": "string", "pattern": "[Ss]amsung" },
            "model": { "type": "string", "minLength": 2 },
            "upgradePreservedData": { "const": true },
            "permissionsPreserved": { "const": true }
          }
        }
      ]
    },
    "emulator": {
      "allOf": [
        { "$ref": "#/$defs/baseDevice" },
        {
          "type": "object",
          "required": [
            "deviceType",
            "avdName",
            "installAndLaunch",
            "dataMigration"
          ],
          "properties": {
            "deviceType": { "const": "emulator" },
            "avdName": { "type": "string", "minLength": 2 },
            "installAndLaunch": { "const": true },
            "dataMigration": { "const": true }
          }
        }
      ]
    }
  }
}
