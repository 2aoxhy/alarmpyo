<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarmpyo_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:contentDescription="@string/alarmpyo_widget_description"
    android:padding="2dp">

    <!-- Center the complete text group; no independently stretched panels. -->
    <LinearLayout
        android:id="@+id/alarmpyo_widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/alarmpyo_widget_background"
        android:gravity="center"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/alarmpyo_widget_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/alarmpyo_widget_preview_date"
            android:textColor="@color/alarmpyo_text_secondary"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/alarmpyo_widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/alarmpyo_widget_preview_title"
            android:textColor="@color/alarmpyo_text_primary"
            android:textSize="24sp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/alarmpyo_widget_schedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/alarmpyo_widget_preview_schedule"
            android:textColor="@color/alarmpyo_text_secondary"
            android:textSize="14sp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/alarmpyo_widget_bottom_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/alarmpyo_widget_preview_next_value"
            android:textColor="@color/alarmpyo_text_secondary"
            android:textSize="14sp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/alarmpyo_widget_secondary_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/alarmpyo_widget_preview_next_value"
            android:textColor="@color/alarmpyo_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/alarmpyo_widget_meaning_line"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/alarmpyo_widget_icon_unknown"
        android:importantForAccessibility="no" />
</FrameLayout>
