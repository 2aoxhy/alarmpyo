<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarmpyo_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:contentDescription="@string/alarmpyo_widget_description"
    android:padding="2dp">

    <LinearLayout
        android:id="@+id/alarmpyo_widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/alarmpyo_widget_background"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:paddingStart="13dp"
        android:paddingTop="4dp"
        android:paddingEnd="7dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/alarmpyo_widget_primary_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="11"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/alarmpyo_widget_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/alarmpyo_widget_preview_date"
                android:textColor="@color/alarmpyo_text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/alarmpyo_widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/alarmpyo_widget_preview_title"
                    android:textColor="@color/alarmpyo_text_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/alarmpyo_widget_schedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/alarmpyo_widget_preview_schedule"
                    android:textColor="@color/alarmpyo_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/alarmpyo_widget_primary_divider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:alpha="0.22"
            android:background="@color/alarmpyo_text_primary"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/alarmpyo_widget_secondary_panel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="10"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="0dp"
            android:paddingEnd="10dp"
            android:paddingBottom="0dp">

            <LinearLayout
                android:id="@+id/alarmpyo_widget_secondary_first"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/alarmpyo_widget_bottom_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/alarmpyo_widget_preview_next_label"
                    android:textColor="@color/alarmpyo_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/alarmpyo_widget_bottom_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="1dp"
                    android:maxLines="1"
                    android:text="@string/alarmpyo_widget_preview_next_value"
                    android:textColor="@color/alarmpyo_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/alarmpyo_widget_secondary_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:alpha="0.18"
                android:background="@color/alarmpyo_text_primary"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/alarmpyo_widget_secondary_second"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/alarmpyo_widget_secondary_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/alarmpyo_widget_preview_next_label"
                    android:textColor="@color/alarmpyo_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/alarmpyo_widget_secondary_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/alarmpyo_widget_preview_next_value"
                    android:textColor="@color/alarmpyo_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- A narrow semantic rail keeps shift color separate from the neutral card. -->
    <FrameLayout
        android:id="@+id/alarmpyo_widget_meaning_line"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@color/alarmpyo_widget_icon_unknown"
        android:importantForAccessibility="no" />
</FrameLayout>
