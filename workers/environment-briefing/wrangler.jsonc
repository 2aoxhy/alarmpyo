{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alarmpyo-environment-briefing",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-21",
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "ENVIRONMENT_RATE_LIMITER",
      "namespace_id": "15001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": false
    }
  }
}
