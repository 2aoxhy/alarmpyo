{
  "cli": {
    "version": ">=20.5.1 <22.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "24.16.0",
      "autoIncrement": false
    },
    "canary": {
      "extends": "base",
      "environment": "preview",
      "distribution": "internal",
      "channel": "canary",
      "env": {
        "ALARMPYO_DISTRIBUTION": "direct"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "stable": {
      "extends": "base",
      "environment": "production",
      "distribution": "internal",
      "channel": "stable",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "distribution": "store",
      "channel": "production",
      "env": {
        "ALARMPYO_DISTRIBUTION": "play"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "internal": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
